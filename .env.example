DATABASE_URL=postgresql://marketmate:local_only_change_me@localhost:55433/marketmate
PORT=4100
WEB_ORIGIN=http://localhost:3000
MAIL_MODE=file
MAIL_DIRECTORY=.local-mail
# Production requires BREVO_API_KEY and MAIL_FROM.
# Private Cloudflare R2 bucket credentials stay on the API server.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_JURISDICTION=
ASSET_SIGNING_KEY=
# Set only to the actual trusted reverse proxy IPs or CIDRs, if applicable.
TRUST_PROXY=
STUDIO_LOCAL_GENERATOR=false
STUDIO_MONTHLY_UNITS=25
