DATABASE_URL=postgresql://marketmate:local_only_change_me@localhost:55433/marketmate
PORT=4100
WEB_ORIGIN=http://localhost:3000
MAIL_MODE=file
MAIL_DIRECTORY=.local-mail
# Set MAIL_MODE=brevo to deliver verification and password-reset emails.
# Use a Brevo API key (not an SMTP key) and a verified Brevo sender address.
BREVO_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=MarketMate
# Production requires MAIL_MODE=brevo and an HTTPS WEB_ORIGIN.
# Private Cloudflare R2 bucket credentials stay on the API server.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Leave empty for the default endpoint; supported jurisdictions: eu, fedramp.
# The S3 region is already set to auto in code; do not put auto here.
R2_JURISDICTION=
ASSET_SIGNING_KEY=
# Set only to the actual trusted reverse proxy IPs or CIDRs, if applicable.
TRUST_PROXY=
STUDIO_LOCAL_GENERATOR=false
STUDIO_MONTHLY_UNITS=25

STUDIO_MONTHLY_GRAPHICS=100

# Development Swagger is available at /api/docs. Enable explicitly in production.
SWAGGER_ENABLED=false
# Set true only after finance/tax-use-case and financial retention review.
# Production issuance remains disabled until then; draft creation is available.
SALES_LAUNCH_APPROVED=false
# Dedicated database for test:sales. Its name must include "test".
TEST_DATABASE_URL=

# AI: OpenAI is selected. Live calls stay disabled until all values below are set.
# Keep STUDIO_LOCAL_GENERATOR=false to use OpenAI; true selects labelled samples in development.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Use a Responses API model supporting strict structured outputs. No model is guessed.
OPENAI_MODEL=
AI_DAILY_BUDGET_USD=
# Approved current model rates, in USD per million tokens. Cached input is conservatively
# charged at the full input rate here. Set a dated price-version identifier for audit.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AI_PRICE_VERSION=
AI_MAX_OUTPUT_TOKENS=1600
AI_TIMEOUT_MS=30000

# Per-business capacities. Stored bytes include all R2 files and pending reservations.
ACTIVE_PRODUCT_LIMIT=50
STORAGE_LIMIT_BYTES=524288000
