{
  "name": "@marketmate/api",
  "private": true,
  "scripts": {
    "start:dev": "tsc && node --watch dist/main.js",
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit",
    "prisma": "prisma",
    "start": "node dist/main.js",
    "test:sales": "node test/run-sales.mjs",
    "test:sales-unit": "pnpm build && node test/sales-money.mjs",
    "test:sales-pdf": "pnpm build && node test/sales-pdf.mjs",
    "test:ai-unit": "pnpm build && node test/openai.mjs && node test/openai-budget.mjs",
    "test:marketing-unit": "pnpm build && node test/marketing-completion.mjs",
    "check:deps": "node scripts/check-dependencies.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.8",
    "@prisma/client": "^6.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.5.0",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.7",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.18.2"
}
