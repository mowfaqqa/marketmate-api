generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id @default(uuid())
  email String @unique
  passwordHash String
  verifiedAt DateTime?
  createdAt DateTime @default(now())
  memberships Membership[]
  sessions Session[]
  tokens AccountToken[]
}
model Business {
  id String @id @default(uuid())
  name String
  category String @default("")
  description String @default("")
  location String @default("")
  language String @default("en-NG")
  version Int @default(0)
  updatedAt DateTime @updatedAt
  timezone String @default("Africa/Lagos")
  brandColor String @default("#166534")
  logoKey String?
  contact String?
  tone String @default("friendly")
  createdAt DateTime @default(now())
  memberships Membership[]
  products Product[]
  customers Customer[]
  salesDocuments SalesDocument[]
  salesActions SalesAction[]
  invoiceSequence Int @default(0)
  quotationSequence Int @default(0)
}
model Membership {
  id String @id @default(uuid())
  userId String @unique
  businessId String @unique
  role String @default("OWNER")
  user User @relation(fields: [userId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
}

model Session {
  id String @id
  userId String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model AccountToken {
  id String @id
  userId String
  purpose String
  expiresAt DateTime
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum PricingMode {
  FIXED
  INQUIRY
}

enum AssetStatus {
  PENDING
  READY
  REJECTED
  DELETING
}

enum OfferStatus {
  ENABLED
  CANCELLED
}

model Product {
  id String @id @default(uuid())
  businessId String
  type ProductType
  name String
  category String @default("")
  description String @default("")
  pricingMode PricingMode
  priceKobo BigInt?
  currency String @default("NGN")
  materialSize String @default("")
  serviceArea String @default("")
  fulfilmentTerms String @default("")
  confirmedClaims String @default("")
  primaryAssetId String?
  archivedAt DateTime?
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  business Business @relation(fields: [businessId], references: [id])
  primaryAsset MediaAsset? @relation("PrimaryAsset", fields: [businessId, primaryAssetId], references: [businessId, id])
  assets MediaAsset[] @relation("ProductAssets")
  offers Offer[]
  studioJobs StudioJob[]
  @@unique([businessId, id])
  @@index([businessId, archivedAt, createdAt])
}

model MediaAsset {
  id String @id @default(uuid())
  businessId String
  productId String
  objectKey String @unique @default(uuid())
  storageProvider String @default("R2")
  fullKey String?
  previewKey String?
  status AssetStatus @default(PENDING)
  uploadTokenHash String
  rightsConfirmedAt DateTime @default(now())
  uploadExpiresAt DateTime
  productVersion Int
  checksum String?
  width Int?
  height Int?
  bytes Int?
  content Bytes?
  preview Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation("ProductAssets", fields: [businessId, productId], references: [businessId, id])
  primaryFor Product[] @relation("PrimaryAsset")
  @@unique([businessId, id])
  @@index([businessId, productId])
}

model Offer {
  id String @id @default(uuid())
  businessId String
  productId String
  promoPriceKobo BigInt
  assertedPriorPriceKobo BigInt?
  startsAt DateTime
  endsAt DateTime
  terms String @default("")
  status OfferStatus @default(ENABLED)
  version Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product Product @relation(fields: [businessId, productId], references: [businessId, id])
  @@unique([businessId, id])
  @@index([businessId, productId, createdAt])
}

model StudioJob {
  id String @id @default(uuid())
  businessId String
  productId String
  key String
  fingerprint String
  status String @default("pending")
  period DateTime
  units Int
  facts Json
  provider String @default("local")
  model String?
  leaseToken String?
  leaseUntil DateTime?
  planBatchId String?
  planBatch MarketingPlan? @relation("PlanGeneration", fields: [planBatchId], references: [id], onDelete: Restrict)
  aiAttempts AiAttempt[]
  error String?
  archived Boolean @default(false)
  createdAt DateTime @default(now())
  drafts StudioDraft[]
  plannedDay MarketingDay?
  product Product @relation(fields: [businessId, productId], references: [businessId, id])
  @@unique([businessId, key])
  @@index([businessId, period, status])
  @@index([status, createdAt])
  @@index([planBatchId])
}

model StudioDraft {
  id String @id @default(uuid())
  jobId String
  variant Int
  revision Int
  text String
  approvedAt DateTime?
  approvedBy String?
  feedback String?
  graphics StudioGraphic[]
  job StudioJob @relation(fields: [jobId], references: [id])
  @@unique([jobId, variant, revision])
}

model StudioGraphic {
  id String @id @default(uuid())
  businessId String
  draftId String
  hash String
  specification Json
  objectKey String
  status String
  period DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  draft StudioDraft @relation(fields: [draftId], references: [id])
  @@unique([businessId, hash])
  @@index([businessId, period, status])
}

model MarketingPlan {
  id String @id @default(uuid())
  businessId String
  key String
  start String
  goal String
  productIds String[]
  status String @default("ready")
  period DateTime?
  units Int @default(0)
  generationJobs StudioJob[] @relation("PlanGeneration")
  createdAt DateTime @default(now())
  days MarketingDay[]
  @@unique([businessId, key])
  @@index([businessId, start])
}

model MarketingDay {
  id String @id @default(uuid())
  planId String
  date String
  theme String
  task String
  jobId String @unique
  revision Int @default(0)
  previousJobIds String[] @default([])
  completedAt DateTime?
  completedBy String?
  plan MarketingPlan @relation(fields: [planId], references: [id])
  job StudioJob @relation(fields: [jobId], references: [id])
  @@unique([planId, date])
}

model Customer {
  id String @id @default(uuid())
  businessId String
  name String
  phone String @default("")
  email String @default("")
  address String @default("")
  version Int @default(0)
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  documents SalesDocument[]
  @@unique([businessId, id])
  @@index([businessId, name])
}

model SalesDocument {
  id String @id @default(uuid())
  businessId String
  customerId String
  type String
  status String @default("DRAFT")
  number String?
  version Int @default(0)
  seller Json
  buyer Json
  lines Json
  totals Json
  totalKobo BigInt
  paidKobo BigInt @default(0)
  dueDate String
  issueDate String?
  issuedAt DateTime?
  issuedBy String?
  taxConfirmed Boolean @default(false)
  notes String @default("")
  paymentInstructions String @default("")
  voidReason String?
  voidedAt DateTime?
  voidedBy String?
  sourceQuotationId String? @unique
  sourceQuotation SalesDocument? @relation("Conversion", fields: [sourceQuotationId], references: [id], onDelete: Restrict)
  convertedInvoice SalesDocument? @relation("Conversion")
  replacesId String? @unique
  replaces SalesDocument? @relation("Replacement", fields: [replacesId], references: [id], onDelete: Restrict)
  replacement SalesDocument? @relation("Replacement")
  pdfStatus String @default("NONE")
  pdfRevision Int @default(0)
  pdfToken String?
  pdfLeaseUntil DateTime?
  pdfKey String?
  pdfError String?
  templateVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer Customer @relation(fields: [businessId, customerId], references: [businessId, id], onDelete: Restrict)
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  payments ManualPayment[]
  @@unique([businessId, id])
  @@unique([businessId, number])
  @@index([businessId, createdAt, id])
  @@index([pdfStatus, pdfLeaseUntil])
}

model ManualPayment {
  id String @id @default(uuid())
  businessId String
  documentId String
  amountKobo BigInt
  date String
  method String
  reference String @default("")
  recordedBy String
  createdAt DateTime @default(now())
  document SalesDocument @relation(fields: [businessId, documentId], references: [businessId, id], onDelete: Restrict)
  reversal PaymentReversal?
  @@unique([businessId, id])
}

model PaymentReversal {
  id String @id @default(uuid())
  paymentId String @unique
  reason String
  recordedBy String
  createdAt DateTime @default(now())
  payment ManualPayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
}

model SalesAction {
  id String @id @default(uuid())
  businessId String
  key String
  fingerprint String
  result Json
  createdAt DateTime @default(now())
  business Business @relation(fields: [businessId], references: [id], onDelete: Restrict)
  @@unique([businessId, key])
}


model AiBudgetDay {
  date String @id
  reservedMicros BigInt @default(0)
  spentMicros BigInt @default(0)
  alerted Boolean @default(false)
  attempts AiAttempt[]
}

model AiAttempt {
  id String @id @default(uuid())
  jobId String
  day String
  status String @default("pending")
  model String
  promptVersion Int
  policyVersion Int
  priceVersion String
  inputRate Float
  outputRate Float
  reservedMicros BigInt
  costMicros BigInt?
  inputTokens Int?
  outputTokens Int?
  latencyMs Int?
  providerRequestId String?
  providerResponseId String?
  actualModel String?
  createdAt DateTime @default(now())
  settledAt DateTime?
  job StudioJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  budget AiBudgetDay @relation(fields: [day], references: [date], onDelete: Restrict)
  @@index([jobId, createdAt])
  @@index([status, createdAt])
}

// Counts reserved and stored objects; failed/uncertain writes retain their capacity until deletion.
model StoredObject {
  key String @id
  businessId String
  bytes Int
  createdAt DateTime @default(now())
  @@index([businessId])
}

model WaitlistEntry {
  name         String? @db.VarChar(100)
  businessType String? @db.VarChar(250)
  email     String   @id
  createdAt DateTime @default(now())
}
